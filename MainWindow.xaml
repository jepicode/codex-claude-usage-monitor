<Window x:Class="CodexClaudeUsageWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexClaudeUsageWidget"
        Title="Codex + Claude usage" Width="420" Height="610"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#101318" Foreground="#EEF1F5" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Topmost="True" Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#151920" />
    <SolidColorBrush x:Key="CardBrush" Color="#1C222B" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2B323D" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A0A9B8" />
    <SolidColorBrush x:Key="SubtleBrush" Color="#778191" />
    <SolidColorBrush x:Key="AccentBrush" Color="#A6E6BE" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#B8F0CD" />
    <SolidColorBrush x:Key="TrackBrush" Color="#303844" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#485260" />
    <local:ProgressBarFillWidthConverter x:Key="ProgressBarFillWidthConverter" />

    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#142019" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.84" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="{x:Type Button}" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#C0CAE0" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#29313C" />
                <Setter Property="Foreground" Value="#E3E9F4" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.75" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource LinkButton}">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style x:Key="QuotaProgress" TargetType="{x:Type ProgressBar}">
      <Setter Property="Height" Value="8" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Background" Value="{StaticResource TrackBrush}" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ProgressBar}">
            <Grid ClipToBounds="True">
              <Border Background="{TemplateBinding Background}" CornerRadius="4" />
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                      HorizontalAlignment="Left" CornerRadius="4">
                <Border.Width>
                  <MultiBinding Converter="{StaticResource ProgressBarFillWidthConverter}">
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="ActualWidth" />
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value" />
                    <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum" />
                  </MultiBinding>
                </Border.Width>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="7" />
      <Setter Property="MinWidth" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track"
                     Orientation="{TemplateBinding Orientation}"
                     IsDirectionReversed="True"
                     Minimum="{TemplateBinding Minimum}"
                     Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}"
                     ViewportSize="{TemplateBinding ViewportSize}">
                <Track.Thumb>
                  <Thumb Background="{StaticResource ScrollThumbBrush}" Margin="1,2">
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbChrome" Background="{TemplateBinding Background}" CornerRadius="4" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbChrome" Property="Background" Value="#687486" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="QuotaWindowTemplate">
      <StackPanel Margin="0,0,0,10">
        <Grid Margin="0,0,0,7">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="#D8DEE8" />
          <TextBlock Grid.Column="1" Text="{Binding UsedPercent, StringFormat={}{0:0}% used}"
                     FontSize="12" FontWeight="SemiBold" Foreground="#F0F3F8" />
        </Grid>
        <ProgressBar Style="{StaticResource QuotaProgress}" Value="{Binding UsedPercent}" />
        <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource SubtleBrush}" Text="{Binding ResetText}" />
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="#303743" BorderThickness="1" CornerRadius="14">
    <Border.Effect>
      <DropShadowEffect Color="#000000" Opacity="0.34" BlurRadius="22" ShadowDepth="2" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="22,18,18,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="USAGE SUMMARY" Foreground="{StaticResource SubtleBrush}" FontSize="10" FontWeight="Bold" />
          <TextBlock Text="Codex &amp; Claude" FontSize="21" FontWeight="SemiBold" Margin="0,3,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource LinkButton}" Content="Refresh" Click="Refresh_Click" ToolTip="Refresh usage" Margin="0,0,4,0" />
          <Button Style="{StaticResource IconButton}" Content="×" Click="Hide_Click" ToolTip="Hide to tray" />
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" Margin="12,0,10,6"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                    CanContentScroll="False">
        <StackPanel Margin="8,2,8,8">
          <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,0,12">
            <StackPanel>
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" Fill="#8AD9AA" VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock Grid.Column="1" Text="Codex" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="#29313B" CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Codex.Status}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                </Border>
              </Grid>
              <ItemsControl ItemsSource="{Binding Codex.Windows}" ItemTemplate="{StaticResource QuotaWindowTemplate}" />
              <TextBlock Text="{Binding Codex.EmptyText}" Foreground="{StaticResource MutedBrush}"
                         TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,10"
                         Visibility="{Binding Codex.EmptyVisibility}" />
              <TextBlock Text="{Binding Codex.Error}" Foreground="#F09A91" TextWrapping="Wrap"
                         LineHeight="17" Margin="0,0,0,10" Visibility="{Binding Codex.ErrorVisibility}" />
              <WrapPanel VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Content="Connect account"
                        Click="CodexLogin_Click" Margin="0,0,6,0" Visibility="{Binding Codex.ConnectVisibility}" />
                <Button Style="{StaticResource LinkButton}" Content="Usage page" Click="CodexUsage_Click" />
                <Button Style="{StaticResource LinkButton}" Content="Disconnect" Click="CodexDisconnect_Click"
                        Foreground="#E7A39D" Visibility="{Binding Codex.DisconnectVisibility}" />
              </WrapPanel>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                  BorderThickness="1" CornerRadius="11" Padding="16" Margin="0,0,0,12">
            <StackPanel>
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" Fill="#E6A477" VerticalAlignment="Center" Margin="0,0,9,0" />
                <TextBlock Grid.Column="1" Text="Claude" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="#29313B" CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Claude.Status}" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                </Border>
              </Grid>
              <ItemsControl ItemsSource="{Binding Claude.Windows}" ItemTemplate="{StaticResource QuotaWindowTemplate}" />
              <TextBlock Text="{Binding Claude.EmptyText}" Foreground="{StaticResource MutedBrush}"
                         TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,10"
                         Visibility="{Binding Claude.EmptyVisibility}" />
              <TextBlock Text="{Binding Claude.Error}" Foreground="#F09A91" TextWrapping="Wrap"
                         LineHeight="17" Margin="0,0,0,10" Visibility="{Binding Claude.ErrorVisibility}" />
              <WrapPanel VerticalAlignment="Center">
                <Button Style="{StaticResource PrimaryButton}" Content="Connect account"
                        Click="ClaudeLogin_Click" Margin="0,0,6,0" Visibility="{Binding Claude.ConnectVisibility}" />
                <Button Style="{StaticResource LinkButton}" Content="Usage page" Click="ClaudeUsage_Click" />
                <Button Style="{StaticResource LinkButton}" Content="Disconnect" Click="ClaudeDisconnect_Click"
                        Foreground="#E7A39D" Visibility="{Binding Claude.DisconnectVisibility}" />
              </WrapPanel>
              <StackPanel Visibility="{Binding Claude.CodeVisibility}" Margin="0,14,0,0">
                <TextBlock Text="Paste the callback code or URL" Foreground="#D8DEE8" FontSize="11"
                           FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="ClaudeCallback" Background="#151A21" Foreground="#EEF1F5"
                         BorderBrush="#3A4350" BorderThickness="1" Padding="9,8"
                         CaretBrush="#A6E6BE" SelectionBrush="#3B6B50" />
                <Button Style="{StaticResource PrimaryButton}" Content="Complete sign-in"
                        Click="ClaudeComplete_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Expander Header="Account &amp; data" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,2,2,4">
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,8,0,0">
              <StackPanel>
                <TextBlock Text="Codex and Claude OAuth tokens are encrypted for this Windows account."
                           Foreground="{StaticResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" LineHeight="16" />
                <Button Style="{StaticResource LinkButton}" Content="Clear all saved sign-ins"
                        Click="ClearStoredCredentials_Click" HorizontalAlignment="Left" Margin="0,7,0,0"
                        Foreground="#E7A39D" />
              </StackPanel>
            </Border>
          </Expander>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" BorderBrush="#292F38" BorderThickness="0,1,0,0" Padding="20,11" Margin="0,0,0,0">
        <DockPanel LastChildFill="False">
          <TextBlock Text="{Binding UpdatedText}" Foreground="{StaticResource SubtleBrush}" FontSize="10" VerticalAlignment="Center" />
          <Border DockPanel.Dock="Right" Background="#202A25" CornerRadius="8" Padding="8,3">
            <TextBlock Text="LOCAL ONLY" Foreground="#9DC9AD" FontSize="9" FontWeight="Bold" />
          </Border>
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
